  "provenance": {
    "surface.thermal_pairs": {
      "kind": "literature_proxy",
      "source": "takebayashi2012",
      "location": "Table 4 p.8",
      "limitation": "paired effective inverse estimates, unknown original water content; not dry or same WCC mix"
    },
    "surface.storage_kg_m2": {
      "kind": "literature_proxy",
      "source": "yamamoto2006",
      "location": "Table 2 p.9 and 4.2.1",
      "conversion": "119 kg/m3 * 0.05 m = 5.95 kg/m2",
      "limitation": "24h immersion and 30min drainage; not short irrigation uptake; 2.975 assumption, 9.10 different block proxy"
    },
    "surface.reference_water_fraction": {
      "kind": "assumption",
      "source": "model_design",
      "conversion": "Cdry_equivalent = Ceff*depth - cw*reference_fraction*storage",
      "limitation": "unknown water content bracketed 0..1; not recovered dry measurement"
    },
    "surface.emissivity": {
      "kind": "literature_proxy",
      "source": "takebayashi2012",
      "location": "3.1 overall surfaces range 0.97..1.0",
      "limitation": "not Con-W specific; 0.92 stress endpoint from Hu 2017 PPCC"
    },
    "surface.beta_max": {
      "kind": "literature_informed_assumption",
      "source": "takebayashi2012",
      "location": "Table 5 p.8 Con-W/Con-W-prime daily beta 0.02..0.04",
      "limitation": "daily estimate is not beta(W); linear law and 0.08 upper stress scenario are assumptions"
    },
    "surface.beta_shape": {
      "kind": "assumption",
      "source": "model_design",
      "limitation": "beta=bmax*W/Wmax; alternative constant when wet; no fitted resistance curve"
    },
    "base": {
      "kind": "literature_proxy",
      "source": "pham2026",
      "location": "Table 1, Figure 4, Table 2, Eq.9",
      "limitation": "rho and porosity well-graded RCA; c specimen-group mean; k=1 assumed and endpoints stress envelope, not WCC/RCA assembly measurements"
    },
    "water": {
      "kind": "assumption",
      "source": "model_design",
      "limitation": "bucket saturation-gradient rates, constant drainage; 24h max downward 24mm/upward 2.4mm/drainage 2.4mm; not measured K or Ks"
    },
    "weather": {
      "kind": "observations_plus_estimates",
      "source": "kma2025_and_boundary_sources",
      "limitation": "original observations/QC preserved; LW,hc,ra and boundary/wind offsets are proxies"
    },
    "experiment": {
      "kind": "design",
      "source": "user_decisions_and_model_design",
      "limitation": "factorial albedo levels are virtual independent levels; irrigation fraction denotes delivered amount, not retained initial water"
    },
    "constants": {
      "kind": "physical_approximation",
      "source": "fao56_dong2019",
      "limitation": "constant latent heat/water specific heat and density; temperature dependence omitted"
    }
